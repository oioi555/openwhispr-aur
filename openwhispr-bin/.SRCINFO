pkgbase = openwhispr-bin
	pkgdesc = Voice-to-text dictation app with local Whisper/Parakeet and cloud models (pre-built binary)
	pkgver = 1.6.10
	pkgrel = 1
	url = https://github.com/OpenWhispr/openwhispr
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = gtk3
	depends = libdrm
	depends = libxss
	depends = libxtst
	depends = mesa
	depends = nss
